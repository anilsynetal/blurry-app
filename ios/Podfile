# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
  
  # Patch for "Command PhaseScriptExecution failed with a nonzero exit code"
  # This replaces 'readlink -f' with a perl command to canonicalize paths
  # because macOS readlink doesn't support -f flag by default.
  puts "Patching Pods-Runner-frameworks.sh to fix readlink -f issue..."
  frameworks_script_path = File.join(Dir.pwd, 'Pods', 'Target Support Files', 'Pods-Runner', 'Pods-Runner-frameworks.sh')
  if File.exist?(frameworks_script_path)
    text = File.read(frameworks_script_path)
    # Replace the readlink -f command with perl
    new_contents = text.gsub('readlink -f', 'perl -MCwd -e \'print Cwd::abs_path shift\'')
    # Also handle cases where we might have already patched it to just 'readlink'
    new_contents = new_contents.gsub('source="$(readlink "${source}")"', 'source="$(perl -MCwd -e \'print Cwd::abs_path shift\' "${source}")"')
    new_contents = new_contents.gsub('binary="${dirname}/$(readlink "${binary}")"', 'binary="${dirname}/$(perl -MCwd -e \'print Cwd::abs_path shift\' "${binary}")"')
    
    File.open(frameworks_script_path, "w") {|file| file.puts new_contents }
    puts "Successfully patched Pods-Runner-frameworks.sh"
  else
    puts "Warning: Pods-Runner-frameworks.sh not found at #{frameworks_script_path}"
  end
end
